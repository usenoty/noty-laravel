{
    "name": "usenoty/noty-laravel",
    "description": "Non-blocking Noty Notification Channel for Laravel.",
    "type": "library",
    "license": "MIT",
    "autoload": {
      "psr-4": {
        "Noty\\Laravel\\": "src/"
      },
      "files": [
        "src/helpers.php"
      ]
    },
    "autoload-dev": {
      "psr-4": {
        "Noty\\Laravel\\Tests\\": "tests/"
      }
    },
    "require": {
      "php": "^8.1|^8.2|^8.3|^8.4",
      "illuminate/support": "^10.0|^11.0",
      "illuminate/notifications": "^10.0|^11.0",
      "illuminate/queue": "^10.0|^11.0",
      "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
      "orchestra/testbench": "^8.0|^9.0",
      "phpunit/phpunit": "^10.0",
      "mockery/mockery": "^1.5",
      "phpstan/phpstan": "^2.1"
    }, 
    "scripts": {
      "test": "vendor/bin/phpunit",
      "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
      "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G --level=5"
    },
    "extra": {
      "laravel": {
        "providers": [
          "Noty\\Laravel\\Providers\\NotyServiceProvider"
        ],
        "aliases": {
          "Noty": "Noty\\Laravel\\Facades\\Noty"
        }
      }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
  }
