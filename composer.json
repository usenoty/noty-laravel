{
    "name": "usenoty/noty-laravel",
    "description": "Non-blocking Noty Notification Channel for Laravel.",
    "type": "library",
    "keywords": [
        "laravel",
        "noty",
        "notifications",
        "notification-channel",
        "telemetry",
        "events",
        "tracking",
        "non-blocking",
        "async"
    ],
    "homepage": "https://github.com/usenoty/noty-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Noty",
            "homepage": "https://usenoty.com"
        }
    ],
    "support": {
        "issues": "https://github.com/usenoty/noty-laravel/issues",
        "source": "https://github.com/usenoty/noty-laravel"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/usenoty/noty-laravel.git"
    },
    "autoload": {
      "psr-4": {
        "Noty\\Laravel\\": "src/"
      },
      "files": [
        "src/helpers.php"
      ]
    },
    "autoload-dev": {
      "psr-4": {
        "Noty\\Laravel\\Tests\\": "tests/"
      }
    },
    "require": {
      "php": "^8.1|^8.2|^8.3|^8.4",
      "illuminate/support": "^10.0|^11.0",
      "illuminate/notifications": "^10.0|^11.0",
      "illuminate/queue": "^10.0|^11.0",
      "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
      "orchestra/testbench": "^8.0|^9.0",
      "phpunit/phpunit": "^10.0",
      "mockery/mockery": "^1.5",
      "phpstan/phpstan": "^2.1",
      "friendsofphp/php-cs-fixer": "^3.89"
    },
    "scripts": {
      "test": "vendor/bin/phpunit",
      "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
      "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G --level=5",
      "cs-fix": "vendor/bin/php-cs-fixer fix",
      "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff"
    },
    "extra": {
      "laravel": {
        "providers": [
          "Noty\\Laravel\\Providers\\NotyServiceProvider"
        ],
        "aliases": {
          "Noty": "Noty\\Laravel\\Facades\\Noty"
        }
      }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
  }
